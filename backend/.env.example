# backend/.env.example
# 実際の値を入れた backend/.env を作成すること（.envはgit管理対象外）

# --- サーバー基本設定 ---
NODE_ENV=development
PORT=3000

# --- 認証（JWT） ---
# ログイントークンの署名鍵。本番では必ず長いランダム文字列を設定すること。
# 未設定のまま NODE_ENV=production で起動するとサーバーが起動を拒否する。
# 生成例: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Google OAuth（ログイン機能） ---
# Google Cloud Console > APIとサービス > 認証情報 で発行する
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- データベース（PostgreSQL） ---
# 未設定時は postgresql://localhost/ai_fortune を使用
DATABASE_URL=

# --- LLM（診断文生成） ---
# Google AI Studio (https://aistudio.google.com/) で発行する
GEMINI_API_KEY=

# --- VOICEVOX（音声合成、任意） ---
# 未設定時は http://localhost:50021 を使用。
# TTSを使う場合、事前に VOICEVOX Engine を起動しておく必要がある
# （backend/start-voicevox.sh 参照、本番ではデプロイ先で別途起動する必要あり）
VOICEVOX_ENGINE_URL=http://localhost:50021

# --- CORS（本番デプロイ時に必須） ---
# フロントエンドの本番URLをカンマ区切りで指定。未設定時はlocalhostのみ許可（開発用）。
# 例: CORS_ORIGINS=https://ai-fortune.example.com
CORS_ORIGINS=

# 開発専用（任意）：テスト用ログインを有効にする。本番では設定しない
# DEV_LOGIN=1
